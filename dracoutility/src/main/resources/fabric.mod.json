  "license": "GPL-3.0-only",
  "icon": "assets/dracoutility/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["studio.draco.utility.DracoUtilityClient"]
  },
  "mixins": ["dracoutility.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
